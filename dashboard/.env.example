# URL used by the Next.js server to reach the bot API. Keep this private.
API_INTERNAL_URL=http://127.0.0.1:5001/api/v1

# Private API key shared with the bot. The dashboard proxy injects it server-side.
# Do not expose it through a NEXT_PUBLIC_ variable.
DASHBOARD_API_KEY=MIDVOX_SECURE_API_KEY_12345_CHANGE_THIS_ASAP_BY_CODEX_DEVS

# NextAuth Configuration
NEXTAUTH_URL=https://your-vercel-url-here-codex-devs.vercel.app/
NEXTAUTH_SECRET=midvox_nextauth_default_secret_string_2026_change_me_BY_CODEX_DEVS

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server-side dashboard administrator IDs (comma separated). OWNER_IDS also works.
ADMIN_IDS=
# Optional public fallback used only to show or hide the Admin Panel link.
NEXT_PUBLIC_ADMIN_IDS=870179991462236170

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="MidVox"
NEXT_PUBLIC_BRAND_NAME_WORD="ZX"
